# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Local AI Configuration
# URL of your local AI API (e.g., Ollama, LM Studio, etc.)
LOCAL_AI_URL=http://localhost:8000

# AI Model name (e.g., qwen, llama2, mistral, etc.)
AI_MODEL=qwen

# Optional: Environment (development or production)
NODE_ENV=development

# Optional: Port for webhook (Vercel/Railway)
PORT=3000
